        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        <span>Baniloo Labs</span>
      </a>
      <span class="footer-sep" aria-hidden="true">·</span>
      <a class="footer-gh" href="/rss.xml" aria-label="RSS feed">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round"/>
          <circle cx="5" cy="19" r="1.8"/>
        </svg>
        <span>RSS</span>
      </a>
    </div>
  </footer>
</div>

<style>
  .footer-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 48px 64px;
  }

  footer {
    border-top: 1px solid var(--border);
    margin-top: 96px;
    padding: 28px 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px 24px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Fraunces', serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .footer-brand img {
    opacity: 0.9;
    filter: drop-shadow(0 1px 4px rgba(70, 110, 255, 0.3));
  }

  .footer-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-2);
    text-align: center;
    flex: 1 1 auto;
  }

  .footer-links {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .footer-sep {
    color: var(--border-strong);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
  }

  .footer-gh {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-2);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-gh svg {
    width: 15px;
    height: 15px;
  }

  .footer-gh:hover {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .footer-wrapper {
      padding: 0 24px 48px;
    }
    footer {
      justify-content: center;
    }
    .footer-text {
      flex-basis: 100%;
      order: 3;
    }
  }
</style>
