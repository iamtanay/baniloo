---
import MobiusNautilus from './MobiusNautilus.astro';
import ThemeToggle from './ThemeToggle.astro';

const { currentPath = '/' } = Astro.props;
---

<header>
  <a href="/" class="brand" aria-label="Baniloo home">
    <MobiusNautilus class="brand-mark" />
    <span class="brand-name">Baniloo</span>
  </a>

  <nav>
    <a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a>
    <a href="/ideas" class={currentPath === '/ideas' ? 'active' : ''}>Ideas</a>
    <a href="/about" class={currentPath === '/about' ? 'active' : ''}>About</a>
    <ThemeToggle />
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 56px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 48px;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }

  .brand :global(.brand-mark) {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  nav a {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    transition: color 150ms ease;
  }

  nav a:hover {
    color: var(--accent);
  }

  nav a.active {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    header {
      padding: 0 24px;
    }
    nav {
      gap: 18px;
    }
  }
</style>