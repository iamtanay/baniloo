---
interface Props {
  title: string;
  description: string;
  href: string;
  status: 'active' | 'shipped' | 'thinking' | 'dormant';
  date: string;
}

const { title, description, href, status, date } = Astro.props;
const isThinking = status === 'thinking';
---

<a href={isThinking ? '#' : href} class={`idea-card ${isThinking ? 'thinking-disabled' : ''}`} data-thinking-message={isThinking ? "This idea is in early thinking stage — not yet ready to share details" : undefined}>
  <div class="idea-card-top">
    <span class="idea-card-title">
      {title}
      <svg class="idea-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 8h8M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <div class="idea-card-meta">
      <span class={`status-badge ${status}`}>
        <span class="status-dot"></span>
        {status}
      </span>
      <span class="idea-date">{date}</span>
    </div>
  </div>
  <p class="idea-card-desc">{description}</p>
</a>

<style>
  .idea-card {
    position: relative;
    background: var(--surface-1);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 24px;
    text-decoration: none;
    display: block;
    box-shadow: var(--card-shadow);
    overflow: hidden;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
                border-color 200ms ease, box-shadow 260ms ease;
  }

  /* Gradient accent line that grows down the left edge on hover */
  .idea-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--accent), var(--accent-2));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .idea-card:not(.thinking-disabled):hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: var(--card-shadow-hover);
  }

  .idea-card:not(.thinking-disabled):hover::before {
    transform: scaleY(1);
  }

  .idea-card:hover .idea-card-title {
    color: var(--accent);
  }

  .idea-card:not(.thinking-disabled):hover .idea-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .idea-card.thinking-disabled {
    cursor: not-allowed;
  }

  .idea-card.thinking-disabled:hover {
    border-color: var(--border);
  }

  .idea-card.thinking-disabled:hover .idea-card-title {
    color: var(--text);
  }

  .idea-card.thinking-disabled::after {
    content: attr(data-thinking-message);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 8px 12px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px;
    color: var(--text-2);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease;
    z-index: 10;
  }

  .idea-card.thinking-disabled:hover::after {
    opacity: 1;
  }

  .idea-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }

  .idea-card-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    transition: color 150ms ease;
  }

  .idea-arrow {
    width: 15px;
    height: 15px;
    opacity: 0;
    transform: translateX(-5px);
    transition: opacity 200ms ease, transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .idea-card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-2);
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }

  .status-badge.active {
    color: #4CAF82;
    border-color: rgba(76, 175, 130, 0.3);
    background: rgba(76, 175, 130, 0.07);
  }

  .status-badge.active .status-dot {
    box-shadow: 0 0 0 0 rgba(76, 175, 130, 0.5);
    animation: dotPulse 2.4s ease-out infinite;
  }

  @keyframes dotPulse {
    0%   { box-shadow: 0 0 0 0 rgba(76, 175, 130, 0.5); }
    70%  { box-shadow: 0 0 0 5px rgba(76, 175, 130, 0); }
    100% { box-shadow: 0 0 0 0 rgba(76, 175, 130, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-badge.active .status-dot { animation: none; }
  }

  .status-badge.shipped {
    color: #D4A94E;
    border-color: rgba(212, 169, 78, 0.3);
    background: rgba(212, 169, 78, 0.07);
  }

  .status-badge.thinking {
    color: var(--accent);
    border-color: rgba(107, 138, 255, 0.3);
    background: rgba(107, 138, 255, 0.07);
  }

  .status-badge.dormant {
    color: var(--text-2);
    border-color: var(--border);
    background: transparent;
  }

  :global([data-theme="light"]) .status-badge.active {
    color: #2E7D56;
    border-color: rgba(46, 125, 86, 0.25);
    background: rgba(46, 125, 86, 0.06);
  }

  :global([data-theme="light"]) .status-badge.shipped {
    color: #B8860B;
    border-color: rgba(184, 134, 11, 0.25);
    background: rgba(184, 134, 11, 0.06);
  }

  :global([data-theme="light"]) .status-badge.thinking {
    color: #3B5BDB;
    border-color: rgba(59, 91, 219, 0.25);
    background: rgba(59, 91, 219, 0.06);
  }

  .idea-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-2);
  }

  .idea-card-desc {
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .idea-card-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
