---
import Layout from '../layouts/Layout.astro';
import IdeaCard from '../components/IdeaCard.astro';
import { ideas } from '../data/ideas';
---

<Layout
  title="Ideas"
  description="All active and in-progress ideas by Tanay Kashyap — protocols, systems, and infrastructure built from first principles."
  currentPath="/ideas">
  <section class="ideas-page">
    <h1>Ideas</h1>
    <p class="page-intro">
      Protocols, systems, and infrastructure. Some active. Some in progress. All worked through carefully.
    </p>

    <div class="ideas-list">
      {ideas.map((idea) => (
        <IdeaCard
          title={idea.title}
          description={idea.description}
          href={idea.href}
          status={idea.status}
          date={idea.date}
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  .ideas-page h1 {
    font-family: 'Fraunces', serif;
    font-size: 44px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 16px;
  }

  .page-intro {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-2);
    margin-bottom: 48px;
  }

  .ideas-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (max-width: 600px) {
    .ideas-page h1 {
      font-size: 32px;
    }
  }
</style>