---
import Layout from '../layouts/Layout.astro';
import IdeaGroup from '../components/IdeaGroup.astro';
import { ideaGroups } from '../data/ideas';
---

<Layout
  title="Ideas"
  description="All active and in-progress ideas by Tanay Kashyap — protocols and tools under Baniloo Labs, plus solo research and apps, built from first principles."
  currentPath="/ideas">
  <section class="ideas-page">
    <h1 data-reveal>Ideas</h1>
    <p class="page-intro" data-reveal style="--reveal-delay: 60ms">
      Tools and protocols under Baniloo Labs, and a handful I build on my own — from open protocols and research to apps and things shipping this month. All documented as they get built.
    </p>

    <div class="ideas-groups">
      {ideaGroups.map((group, i) => (
        <div data-reveal style={`--reveal-delay: ${120 + i * 80}ms`}>
          <IdeaGroup label={group.label} tagline={group.tagline} ideas={group.ideas} />
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .ideas-page h1 {
    font-family: 'Fraunces', serif;
    font-size: 44px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 16px;
  }

  .page-intro {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-2);
    margin-bottom: 48px;
  }

  @media (max-width: 600px) {
    .ideas-page h1 {
      font-size: 32px;
    }
  }
</style>