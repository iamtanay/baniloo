---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { breadcrumbLd, projectLd } from '../../data/site.js';

const entry = await getEntry('pulsesyn', 'spec');
if (!entry) throw new Error('PulseSyn spec not found');

const { Content } = await entry.render();
const specDescription = "Protocol specification v0.1 for PulseSyn — a decentralized, content-agnostic protocol for validating claims using reputation-weighted consensus.";
---

<Layout
  title="PulseSyn Specification"
  description={specDescription}
  currentPath="/pulsesyn/spec"
  ogType="article"
  jsonLd={[
    projectLd('pulsesyn', '/pulsesyn/spec', specDescription),
    breadcrumbLd([{ name: 'Baniloo', path: '/' }, { name: 'PulseSyn', path: '/pulsesyn' }, { name: 'Specification', path: '/pulsesyn/spec' }]),
  ]}>
  <article class="spec-page">
    <nav class="breadcrumb">
      <a href="/pulsesyn">← Back to PulseSyn</a>
    </nav>

    <div class="spec-content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .breadcrumb {
    margin-bottom: 40px;
  }

  .breadcrumb a {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .spec-content {
    max-width: 720px;
  }

  .spec-content :global(h1) {
    font-family: 'Fraunces', serif;
    font-size: 44px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 12px;
  }

  .spec-content :global(h2) {
    font-family: 'Fraunces', serif;
    font-size: 26px;
    font-weight: 500;
    color: var(--text);
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .spec-content :global(h3) {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .spec-content :global(h4) {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    margin-top: 24px;
    margin-bottom: 10px;
  }

  .spec-content :global(p) {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 1.6em;
  }

  .spec-content :global(ul),
  .spec-content :global(ol) {
    margin-left: 1.5em;
    margin-bottom: 1.6em;
  }

  .spec-content :global(li) {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 0.5em;
  }

  .spec-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.6em;
    font-size: 15px;
  }

  .spec-content :global(th) {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 600;
    font-size: 13px;
    text-align: left;
    padding: 10px 14px;
    border-bottom: 2px solid var(--border);
    color: var(--text-2);
  }

  .spec-content :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    line-height: 1.6;
  }

  .spec-content :global(tr:last-child td) {
    border-bottom: none;
  }

  .spec-content :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 2px 6px;
    border-radius: 3px;
  }

  .spec-content :global(pre) {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    overflow-x: auto;
    margin-bottom: 1.6em;
  }

  .spec-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--code-text);
  }

  .spec-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 12px 16px;
    margin: 0 0 1.6em 0;
    background: var(--surface);
    border-radius: 0 6px 6px 0;
  }

  .spec-content :global(blockquote p) {
    font-style: italic;
    color: var(--text-2);
    margin-bottom: 0;
  }

  .spec-content :global(hr) {
    border: none;
    height: 1px;
    background: var(--border);
    margin: 48px 0;
  }

  .spec-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    transition: opacity 150ms ease;
  }

  .spec-content :global(a:hover) {
    opacity: 0.8;
  }

  /* Diagram blocks */
  .spec-content :global(.diagram) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px 24px;
    margin: 24px 0 1.6em;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    line-height: 1.9;
  }

  .spec-content :global(.diagram-label) {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .spec-content :global(.diagram-row) {
    color: var(--text);
    padding: 1px 0;
  }

  .spec-content :global(.diagram-code) {
    color: var(--accent);
    padding: 2px 0;
  }

  .spec-content :global(.diagram-arrow) {
    color: var(--text-2);
    padding: 2px 0;
    user-select: none;
  }

  .spec-content :global(.diagram-tree) {
    padding-left: 16px;
    color: var(--text-2);
    margin-top: 4px;
  }

  .spec-content :global(.diagram-branch) {
    padding-left: 0;
  }

  .spec-content :global(.branch-left),
  .spec-content :global(.branch-right) {
    color: var(--text);
    padding-left: 12px;
  }

  .spec-content :global(.dim) {
    color: var(--text-2);
  }

  .spec-content :global(.step-tag) {
    display: inline-block;
    font-size: 10px;
    color: var(--accent);
    min-width: 20px;
    margin-right: 6px;
  }

  @media (max-width: 600px) {
    .spec-content :global(h1) { font-size: 32px; }
    .spec-content :global(h2) { font-size: 22px; }
    .spec-content :global(table) { display: block; overflow-x: auto; }
  }
</style>