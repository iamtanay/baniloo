---
import Layout from '../layouts/Layout.astro';
import IdeaCard from '../components/IdeaCard.astro';
import { ideas } from '../data/ideas';
---

<Layout
  title="Baniloo"
  description="Ideas about protocols, systems, and infrastructure — by Tanay Kashyap. Thinking through why things are built the way they are, and what a more deliberate version might look like."
  currentPath="/">
  <section class="hero">
    <p class="section-label">Baniloo</p>
    <h1>Building things — some serious, some just fun.</h1>
    <p class="hero-epigraph">
      A mix of protocols, apps, research, and whatever felt worth making.
    </p>
    <div class="hero-body">
      <p>
        I'm Tanay Kashyap. I'm doing an M.TECH at BITS Pilani and building things on the side — a medical records protocol, a claim validation network, a task tracker I actually use, a gym app, a World Cup fan experience shipping in June. The range is real.
      </p>
      <p>
        Some of these are designed from first principles. Some started because the problem annoyed me. Either way, they're documented here as they get built.
      </p>
    </div>
    <p class="hero-byline">— Tanay Kashyap</p>
  </section>

  <div class="divider"></div>

  <section>
    <div class="ideas-header">
      <h2>Ideas</h2>
      <a href="/ideas">All ideas →</a>
    </div>

    <div class="ideas-list">
      {ideas.map((idea) => (
        <IdeaCard
          title={idea.title}
          description={idea.description}
          href={idea.href}
          status={idea.status}
          date={idea.date}
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    margin-bottom: 64px;
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 24px;
  }

  .hero h1 {
    font-family: 'Fraunces', serif;
    font-size: 44px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 20px;
  }

  .hero-epigraph {
    font-family: 'Fraunces', serif;
    font-size: 17px;
    font-style: italic;
    color: var(--text-2);
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .hero-body {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text);
  }

  .hero-body p + p {
    margin-top: 1.6em;
  }

  .hero-byline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-2);
    margin-top: 28px;
  }

  .divider {
    width: 100%;
    height: 1px;
    background: var(--border);
    margin: 64px 0;
  }

  .ideas-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .ideas-header h2 {
    font-family: 'Fraunces', serif;
    font-size: 26px;
    font-weight: 500;
    color: var(--text);
  }

  .ideas-header a {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .ideas-header a:hover {
    color: var(--accent);
  }

  .ideas-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (max-width: 600px) {
    .hero h1 {
      font-size: 32px;
    }
  }
</style>