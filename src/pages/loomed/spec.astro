---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('loomed', 'spec');
if (!entry) throw new Error('Spec not found');

const { Content } = await entry.render();
---

<Layout title="LooMed Specification — Baniloo" currentPath="/loomed">
  <article class="spec-page">
    <nav class="breadcrumb">
      <a href="/loomed">← Back to LooMed</a>
    </nav>

    <div class="spec-content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .breadcrumb {
    margin-bottom: 40px;
  }

  .breadcrumb a {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .spec-content {
    max-width: 720px;
  }

  .spec-content :global(h1) {
    font-family: 'Fraunces', serif;
    font-size: 44px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 12px;
  }

  .spec-content :global(h2) {
    font-family: 'Fraunces', serif;
    font-size: 26px;
    font-weight: 500;
    color: var(--text);
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .spec-content :global(h3) {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .spec-content :global(p) {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 1.6em;
  }

  .spec-content :global(ul),
  .spec-content :global(ol) {
    margin-left: 1.5em;
    margin-bottom: 1.6em;
  }

  .spec-content :global(li) {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 0.5em;
  }

  .spec-content :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    background: var(--code-bg);
    color: var(--code-text);
    padding: 2px 6px;
    border-radius: 3px;
  }

  .spec-content :global(pre) {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    overflow-x: auto;
    margin-bottom: 1.6em;
  }

  .spec-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: 14px;
    line-height: 1.6;
  }

  .spec-content :global(hr) {
    border: none;
    height: 1px;
    background: var(--border);
    margin: 48px 0;
  }

  .spec-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    transition: opacity 150ms ease;
  }

  .spec-content :global(a:hover) {
    opacity: 0.8;
  }

  @media (max-width: 600px) {
    .spec-content :global(h1) {
      font-size: 32px;
    }

    .spec-content :global(h2) {
      font-size: 22px;
    }
  }
</style>
