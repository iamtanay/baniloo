---
import Layout from '../../layouts/Layout.astro';
import { projectLd, breadcrumbLd } from '../../data/site.js';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('vigor');
const entries = allEntries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Vigor"
  description="A pay-per-use gym and fitness venue app. Walk in, scan a QR, train, scan out. No memberships required."
  currentPath="/vigor"
  jsonLd={[
    projectLd('vigor', '/vigor'),
    breadcrumbLd([{ name: 'Baniloo', path: '/' }, { name: 'Vigor', path: '/vigor' }]),
  ]}>
  <section class="project-page">
    <div class="project-header">
      <div class="project-header-top">
        <p class="section-label">Active</p>
        <a href="https://github.com/iamtanay/vigor" target="_blank" rel="noopener noreferrer" class="github-link">
          <svg class="github-icon" viewBox="0 0 24 24" fill="currentColor" aria-label="GitHub repository">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
          <span>iamtanay/vigor</span>
        </a>
      </div>
      <h1>Vigor</h1>
      <p class="project-intro">
        A pay-per-use fitness venue app. No memberships. Walk into any partner gym, load your wallet,
        scan a QR code to start a session, scan again when you leave. You pay for the time you used.
      </p>
      <p class="project-intro">
        Built in four phases: the Supabase foundation, the user module with wallet and venue discovery,
        the QR session lifecycle, and the gym owner portal. The full product — both sides of the door — exists.
      </p>
    </div>

    <div class="divider"></div>

    <section class="entries-section">
      <h2>Notes</h2>
      <p class="section-intro">
        Build log in reverse chronological order.
      </p>

      <div class="entries-list" id="entriesList">
        {entries.map((entry) => (
          <a href={`/vigor/${entry.slug}`} class="entry-card" data-entry-data={JSON.stringify({
            slug: entry.slug,
            title: entry.data.title,
            description: entry.data.description,
            date: entry.data.date.toISOString()
          })}>
            <div class="entry-card-header">
              <span class="entry-date">
                {entry.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}
              </span>
            </div>
            <h3 class="entry-title">{entry.data.title}</h3>
            {entry.data.description && (
              <p class="entry-desc">{entry.data.description}</p>
            )}
          </a>
        ))}
      </div>
    </section>
  </section>
</Layout>

<style>
  .project-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-2);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 12px;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .github-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .github-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .project-page h1 {
    font-family: 'Fraunces', serif;
    font-size: 44px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 24px;
  }

  .project-intro {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 1.6em;
  }

  .divider {
    width: 100%;
    height: 1px;
    background: var(--border);
    margin: 64px 0;
  }

  .entries-section h2 {
    font-family: 'Fraunces', serif;
    font-size: 26px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 12px;
  }

  .section-intro {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
    margin-bottom: 32px;
  }

  .entries-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .entry-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px 24px;
    text-decoration: none;
    display: block;
    transition: border-color 150ms ease;
  }

  .entry-card:hover {
    border-color: var(--accent);
  }

  .entry-card:hover .entry-title {
    color: var(--accent);
  }

  .entry-card-header {
    margin-bottom: 8px;
  }

  .entry-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-2);
  }

  .entry-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 6px;
    transition: color 150ms ease;
  }

  .entry-desc {
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .project-page h1 {
      font-size: 32px;
    }
  }
</style>
